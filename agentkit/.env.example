# MODEL_HTTP_BASE_URL=
# MODEL_HTTP_API_KEY=

# For SpeechClient via HTTP (backend/adapters/speech_http.py)
# SPEECH_HTTP_BASE_URL=
# SPEECH_HTTP_API_KEY=
