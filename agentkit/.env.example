# AgentKit Environment Variables
# -------------------------------

# The host and port for the FastAPI server
HOST=127.0.0.1
PORT=8000

# --- Phase 2: HTTP Adapters ---
# These are not used in the bootstrap (v1) but are here as placeholders
# for the generic HTTP model and speech clients.

